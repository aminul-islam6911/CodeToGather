# Copy to .env and fill in. NEVER commit .env.
# Every variable the app reads is defined in src/lib/env.ts (zod, fail-fast at boot).
# Config errors name the variable only; values are never printed.

# --- App runtime ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Release identifier attached to logs, metrics and Sentry (e.g. the commit SHA).
APP_VERSION=dev
# Comma-separated browser origins allowed by CORS. Empty = same-origin only.
CORS_ORIGINS=

# --- Required dependencies (no defaults; app fails fast if missing) ---
# Postgres. In Docker Compose the app is pointed at the `postgres` service automatically.
DATABASE_URL=postgres://codetogather:local-dev-password@localhost:5432/codetogather
# Redis (sessions, rate limits, cache, BullMQ).
REDIS_URL=redis://localhost:6379
# Session signing secret. Generate a random 32+ char value; store in a secret manager outside local dev.
SESSION_SECRET=replace-with-a-random-32-plus-character-secret

# --- Optional ---
# Sentry DSN. Leave empty to disable error tracking.
SENTRY_DSN=
# OTLP HTTP base endpoint for traces (e.g. http://localhost:4318). Empty disables tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Docker Compose only (used by docker-compose.yml, not read by the app) ---
POSTGRES_USER=codetogather
POSTGRES_PASSWORD=local-dev-password
POSTGRES_DB=codetogather
