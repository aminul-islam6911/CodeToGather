{
  "name": "codetogather",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Real-time collaborative code editor with a VS Code-like web interface.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server/index.js",
    "lint": "eslint . && node scripts/check-import-boundaries.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "openapi:lint": "node scripts/validate-openapi.mjs",
    "audit": "npm audit --audit-level=high",
    "secret:scan": "gitleaks detect --no-git --redact -v",
    "rules:validate": "node scripts/validate-cursor-rules.mjs",
    "backup:drill": "node scripts/backup-restore.mjs",
    "rollback": "node scripts/rollback.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@sentry/node": "^10.0.0",
    "fastify": "^5.0.0",
    "ioredis": "^5.4.1",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "prom-client": "^15.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.17.0",
    "picomatch": "^4.0.2",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^5.0.3"
  }
}
